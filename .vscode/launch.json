{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Calculator Console",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/examples/calculator/run_calculator.py",
            "cwd": "${workspaceFolder}/examples/calculator",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Calculator Console (Verbose)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/examples/calculator/run_calculator.py",
            "args": ["-v"],
            "cwd": "${workspaceFolder}/examples/calculator",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Integration Tests",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "pytest",
            "args": ["integration_tests/", "-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
